{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "src/**",
      "feature/src/**",
      "tpl/src/**",
      "detach/src/**",
      "guide/src/**",
      "*.ts",
      "*.js",
      "*.json"
    ],
    "ignoreUnknown": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noSvgWithoutTitle": "off",
        "useValidLang": "off",
        "useHtmlLang": "off"
      },
      "complexity": {
        "useOptionalChain": "warn",
        "noBannedTypes": "off",
        "useLiteralKeys": "off",
        "useMathMinMax": "off",
        "noArguments": "off"
      },
      "correctness": {
        "noUnusedVariables": "warn",
        "noUnusedImports": "warn",
        "noUnusedFunctionParameters": "warn",
        "useParseIntRadix": "warn"
      },
      "performance": {
        "noDynamicNamespaceImportAccess": "off"
      },
      "style": {
        "useNodejsImportProtocol": "off",
        "useTemplate": "off",
        "useVueMultiWordComponentNames": "off"
      },
      "suspicious": {
        "noExplicitAny": "off",
        "noImplicitAnyLet": "off",
        "noDoubleEquals": "warn",
        "noAssignInExpressions": "warn"
      }
    }
  },
  "json": {
    "formatter": {
      "enabled": false
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
