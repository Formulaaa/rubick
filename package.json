{
  "name": "rubick",
  "version": "4.3.8",
  "author": "muwoo <2424880409@qq.com>",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "build:feature": "pnpm --filter feature build",
    "build:apps": "pnpm --filter feature build && pnpm --filter tpl build && pnpm --filter detach build && pnpm --filter guide build",
    "dev:feature": "pnpm --filter feature dev",
    "dev:tpl": "pnpm --filter tpl dev",
    "dev:detach": "pnpm --filter detach dev",
    "dev:guide": "pnpm --filter guide dev",
    "package": "pnpm build:apps && pnpm build && electron-builder",
    "package:mac": "pnpm build:apps && pnpm build && electron-builder --mac --x64 --arm64",
    "package:mac:arm64": "pnpm build:apps && pnpm build && electron-builder --mac --arm64",
    "package:win": "pnpm build:apps && pnpm build && electron-builder --win --x64 --ia32",
    "package:linux": "pnpm build:apps && pnpm build && electron-builder --linux",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "postinstall": "electron-builder install-app-deps",
    "package:mac:x64": "pnpm build:apps && pnpm build && electron-builder --mac --x64"
  },
  "optionalDependencies": {
    "electron-clipboard-ex": "^1.3.3"
  },
  "dependencies": {
    "@ant-design/icons-vue": "6.1.0",
    "@electron/remote": "^2.1.3",
    "ant-design-vue": "3.2.20",
    "axios": "^1.21.0",
    "cross-spawn": "^7.0.6",
    "electron-updater": "^6.8.11",
    "extract-file-icon": "^0.3.2",
    "fix-path": "3.0.0",
    "fs-extra": "^11.4.1",
    "get-mac-apps": "^1.0.2",
    "got": "11.8.6",
    "lodash.debounce": "^4.0.8",
    "memorystream": "^0.3.1",
    "node-key-sender": "^1.0.11",
    "npm": "^11.0.0",
    "pinyin-match": "^1.2.10",
    "plist": "^3.1.0",
    "pouchdb": "^9.0.0",
    "pouchdb-load": "^2.0.0",
    "pouchdb-replication-stream": "^1.2.9",
    "semver": "^7.8.5",
    "simple-plist": "^1.3.1",
    "uiohook-napi": "^1.5.5",
    "vue": "3.5.44",
    "vue-router": "4.6.4",
    "vuex": "4.1.0",
    "webdav": "4.11.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/cross-spawn": "^6.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/lodash.debounce": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/plist": "^3.0.5",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "electron-vite": "^6.0.0",
    "less": "^4.9.1",
    "typescript": "5.9.3",
    "vite": "^8.3.5",
    "vue-tsc": "3.3.13"
  }
}
